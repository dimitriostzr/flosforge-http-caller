{
  "name": "flosforge-caller",
  "productName": "FlosForge Caller",
  "desktopName": "flosforge-caller.desktop",
  "version": "0.2.0",
  "description": "FlosForge Caller: a free, local-first, account-free HTTP API client. Opens the collections you already have.",
  "main": "./out/main/index.js",
  "bin": {
    "flosforge-caller": "out/cli/index.cjs"
  },
  "author": "Dimitrios Tzortzis",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/dimitriostzr/flosforge-http-caller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimitriostzr/flosforge-http-caller.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/third-party.mjs && electron-vite build",
    "notices": "node scripts/third-party.mjs",
    "build:cli": "vite build --config vite.cli.config.ts",
    "cli": "node out/cli/index.cjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@lezer/highlight": "^1.2.5",
    "@types/chai": "^5.2.3",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.26",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^5.2.0",
    "chai": "^6.3.0",
    "crypto-js": "^4.2.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.1",
    "electron-vite": "^5.0.0",
    "immer": "^11.1.21",
    "lodash": "^4.18.1",
    "lucide-react": "^1.56.0",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
